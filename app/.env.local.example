# ─── Supabase ────────────────────────────────────────────────────────────────
# From: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Xero OAuth ──────────────────────────────────────────────────────────────
# From: developer.xero.com → your app → Configuration
# NOTE: Only VITE_ prefixed vars are exposed to the browser.
# Client secret lives in Supabase Edge Function secrets only — never here.
VITE_XERO_CLIENT_ID=your-xero-client-id-here
VITE_XERO_REDIRECT_URI=http://localhost:5173/auth/xero/callback

# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
